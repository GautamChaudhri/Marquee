# Marquee — environment configuration
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# APP_NAME=Marquee
# HOST=0.0.0.0
# PORT=3165
# DEBUG=false
# LOG_LEVEL=INFO
# LOG_FORMAT=text                  # "text" | "json"

# ---------------------------------------------------------------------------
# CORS (for web UI dev servers)
# ---------------------------------------------------------------------------
# CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'

# ---------------------------------------------------------------------------
# Shutdown
# ---------------------------------------------------------------------------
# SHUTDOWN_TIMEOUT_SECONDS=10      # Max seconds to wait for clients during shutdown

# ---------------------------------------------------------------------------
# TMDB (The Movie Database)
# Register at: https://www.themoviedb.org/settings/api
# ---------------------------------------------------------------------------
# TMDB_READ_ACCESS_TOKEN=your_bearer_token_here

# ---------------------------------------------------------------------------
# Fanart.tv
# Register at: https://fanart.tv/get-an-api-key/
# ---------------------------------------------------------------------------
# FANART_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# TheTVDB
# Register at: https://thetvdb.com/api-information
# ---------------------------------------------------------------------------
# TVDB_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Radarr
# API key found at: Radarr → Settings → General → API Key
# ---------------------------------------------------------------------------
# RADARR_URL=http://localhost:7878
# RADARR_API_KEY=your_radarr_api_key

# ---------------------------------------------------------------------------
# Sonarr
# API key found at: Sonarr → Settings → General → API Key
# ---------------------------------------------------------------------------
# SONARR_URL=http://localhost:8989
# SONARR_API_KEY=your_sonarr_api_key
# SERIES_POSTER_FORMAT=show.jpg
# SEASON_POSTER_FORMAT=season{season:02d}.jpg

# ---------------------------------------------------------------------------
# Path Mapping (only needed if running on different machine than *arrs)
#
# Radarr and Sonarr may see different mount paths than Marquee.
# Configure each pair independently — leave unset if paths are the same.
#
# Examples:
#   Radarr sees /plunder/movies, Mac sees /Volumes/PLUNDER/Media/Movies:
#     RADARR_PATH_PREFIX=/plunder/movies
#     RADARR_MEDIA_PATH=/Volumes/PLUNDER/Media/Movies
#
#   Sonarr sees /plunder/tv, Mac sees /Volumes/PLUNDER/Media/TV:
#     SONARR_PATH_PREFIX=/plunder/tv
#     SONARR_MEDIA_PATH=/Volumes/PLUNDER/Media/TV
# ---------------------------------------------------------------------------
# RADARR_PATH_PREFIX=/plunder/movies
# RADARR_MEDIA_PATH=/Volumes/PLUNDER/Media/Movies
# SONARR_PATH_PREFIX=/plunder/tv
# SONARR_MEDIA_PATH=/Volumes/PLUNDER/Media/TV

# ---------------------------------------------------------------------------
# Media Roots (optional — auto-derived from RADARR_MEDIA_PATH + SONARR_MEDIA_PATH)
#
# Manually add extra allowed directories if needed. Radarr/Sonarr media
# paths are automatically included. Leave empty to auto-derive only.
# ---------------------------------------------------------------------------
# MEDIA_ROOTS='["/Volumes/PLUNDER/Media/Movies","/Volumes/PLUNDER/Media/TV"]'

# ---------------------------------------------------------------------------
# Sync intervals (minutes)
# ---------------------------------------------------------------------------
# SYNC_INTERVAL_MINUTES=15
# SYNC_COOLDOWN_SECONDS=300        # Min seconds between manual sync triggers (rate limit)
# HEAL_INTERVAL_MINUTES=30
# HEAL_ENABLED=true                # Run the periodic self-heal poster existence scan

# ---------------------------------------------------------------------------
# Webhooks (Radarr/Sonarr → poster restoration)
# ---------------------------------------------------------------------------
# WEBHOOK_TOKEN=                   # When set, webhook requests must carry ?token=<this>
# WEBHOOK_DRY_RUN=false            # Log webhook events without touching the filesystem

# ---------------------------------------------------------------------------
# Poster Cache & Staging
# ---------------------------------------------------------------------------
# POSTER_CACHE_DIR=data/cache/posters
# POSTER_STAGING_DIR=data/staging

# ---------------------------------------------------------------------------
# Poster Filename Formats
#   {movie_basename} — movie filename without extension (movies only)
#   {season}         — season number (seasons only)
#   {season:02d}     — zero-padded season number (seasons only)
# ---------------------------------------------------------------------------
# MOVIE_POSTER_FORMAT=poster.jpg
# SERIES_POSTER_FORMAT=poster.jpg
# SEASON_POSTER_FORMAT=season{season:02d}-poster.jpg

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_URL=sqlite+aiosqlite:///./data/marquee.db

# ---------------------------------------------------------------------------
# Letterbox Crop Detection (design 04-letterbox)
# ---------------------------------------------------------------------------
# LETTERBOX_ENABLED=true
# LETTERBOX_DETECT_METHOD=cropdetect # cropdetect (ffmpeg) | trim (ImageMagick)
# LETTERBOX_TRIM_FUZZ='[5,15,25]'   # Fuzz percentages for trim backend
# LETTERBOX_FFMPEG=ffmpeg
# LETTERBOX_FFPROBE=ffprobe
# LETTERBOX_MKVPROPEDIT=mkvpropedit
# LETTERBOX_MKVMERGE=mkvmerge
# LETTERBOX_CONVERT=convert          # ImageMagick convert (trim backend only)
# LETTERBOX_MOVIE_SAMPLES_MIN=5      # Movie sampling start (minutes)
# LETTERBOX_MOVIE_SAMPLES_MAX=60     # Movie sampling end (minutes)
# LETTERBOX_MOVIE_SAMPLE_STEP=5      # Minutes between movie samples
# LETTERBOX_TV_SAMPLES='[5,10,15]'   # Sample timestamps for TV episodes (minutes)
# LETTERBOX_WINDOW_SECONDS=2         # cropdetect accumulation window per sample
# LETTERBOX_CROPDETECT_LIMIT=24      # cropdetect black-luma threshold (0-255)
# LETTERBOX_CROPDETECT_HDR_LIMIT=80  # cropdetect black-luma threshold for HDR/PQ/HLG
# LETTERBOX_CROPDETECT_ROUND=2       # cropdetect dimension rounding (must be even)
# LETTERBOX_NOISE_PX=4               # Bars ≤ this px count as "no bars"
# LETTERBOX_MIN_BAR_PX=8             # A bar must exceed this to count as a real scope bar
# LETTERBOX_AGREE_PX=2               # Max spread across samples for High confidence
# LETTERBOX_MEDIUM_SPREAD_PX=20      # Spread boundary between Medium and Low confidence
# LETTERBOX_ASYM_PX=2                # Top/bottom asymmetry tolerance before honoring uneven bars
# LETTERBOX_EARLY_STOP_WINDOWS=3     # Consecutive no-bar samples that trigger early termination
# LETTERBOX_MAX_PARALLEL=0           # Batch-detect workers; 0 = auto (cpu_count - 1)
# LETTERBOX_AUTO_APPLY_HIGH=false    # Opt-in: auto-apply High-confidence detections
# LETTERBOX_ASYMMETRIC=false         # Honor uneven top/bottom bars instead of forcing symmetry
# LETTERBOX_HEAL_ENABLED=true        # Run the periodic letterbox tag-drift verification scan
# LETTERBOX_HEAL_INTERVAL_MINUTES=360 # Minutes between letterbox tag-drift scans

# ---------------------------------------------------------------------------
# Revised Poster Pipeline
# All values below are environment-overridable.
# ---------------------------------------------------------------------------
# AI_MODEL=clip-vit-b-32              # or clip-vit-b-32-int8 (CPU-only hosts; rebuild profile)
# EXECUTION_PROVIDER=auto             # auto | cuda | openvino | openvino-cpu | coreml | cpu
# CLIP_BATCH_SIZE=0                   # 0 = auto by hardware tier (GPU 32, CPU 8)
# K_NEIGHBORS=10
# KNN_WEIGHTING=softmax               # softmax = nearest exemplars dominate; mean = plain average
# KNN_SOFTMAX_TEMP=0.1                # smaller = sharper multimodal clusters
# TASTE_NEG_WEIGHT=1.0                # junk-lookalike penalty (needs negative exemplars)
# PREFERRED_LANG=en
#
# --- Extended features (design/07) ---
# DINO_ENABLED=auto                   # auto = on for GPU tiers, off on CPU; on/off force
# EXTRA_QUALITY_ENABLED=true          # rec-5 flag: artifact metrics + person detector
# CALIBRATION_ENABLED=true            # exemplar-calibrated typicality (rec 2)
# CALIBRATION_BANDWIDTH_SCALE=1.0     # >1 = wider/more forgiving taste bands
# SCORER=auto                         # auto | weighted | learned (Phase-1 head)
# WEIGHT_DINO_KNN=0.12
# WEIGHT_TASTE_TYPICALITY=0.12
# WEIGHT_QUALITY_ARTIFACTS=0.03
# WEIGHT_OFFICIAL_FAMILY=0.12        # CLIP cosine to the movie's TMDB primary poster
# NORM_OFFICIAL_MIN=0.60             # official_family ramp (cosine -> 0..1)
# NORM_OFFICIAL_MAX=0.95
#
# CLIP_MODEL_PATH=marquee/ml/models/clip-vit-b-32.onnx     # follows AI_MODEL by default
# AESTHETIC_MODEL_PATH=marquee/ml/models/sa_0_4_vit_b_32_linear.pth
# FACE_MODEL_PATH=marquee/ml/models/scrfd_500m_bnkps.onnx
# TASTE_PROFILE_PATH=marquee/ml/taste_profile.clip-vit-b-32.npz  # follows AI_MODEL by default
# EMBEDDING_CACHE_DIR=data/cache/embeddings
#
# WEIGHT_KNN_SIM=0.30
# WEIGHT_AESTHETIC=0.12              # was 0.20 — LAION head loves slick fan art
# WEIGHT_TITLE_COLORFULNESS=0.15
# WEIGHT_FACE_AREA=0.15
# WEIGHT_TEXT_RESIDUAL=0.10
# WEIGHT_PROVENANCE=0.02             # was 0.07 — TMDB poster votes are ~all zero
# WEIGHT_SHARPNESS=0.03
# WEIGHT_RESOLUTION=0.0
# WEIGHT_LANG_MATCH=0.0
#
# GATE_MIN_WIDTH=500
# GATE_MIN_AESTHETIC=4.5
# GATE_MIN_KNN_SIM=0.45
# GATE_FAN_JUNK_ENABLED=false
# GATE_FAN_JUNK_MAX_AESTHETIC=5.0
# GATE_FAN_JUNK_MAX_PROVENANCE=0.55
# GATE_FAN_JUNK_MAX_RESOLUTION_MP=1.0
#
# PROV_PRIOR_MEAN=6.5
# PROV_CONFIDENCE=25
# RESIDUAL_COUNT_SAT=5
# RESIDUAL_WEIGHT_COUNT=0.5
# RESIDUAL_WEIGHT_AREA=0.5
#
# DEDUP_PHASH_THRESHOLD=6
# DEDUP_MIN_POSTER_WIDTH=500
# OCR_WORKERS=0                       # 0 = auto-size from CPU/GPU profile
# OCR_DETAIL_PASSES=true              # false on weak CPUs (N150): ~60% faster OCR
# OCR_MAX_RESIDUAL_BOXES=0            # 0 = strict title-only text (project target);
#                                     # raise to 1-2 to tolerate taglines as rank penalty
# OCR_MAX_RESIDUAL_AREA_FRACTION=0.04 # secondary guard when boxes > 0
# OCR_REQUIRE_TITLE=true              # reject posters whose text never matches the title
# OCR_ACCEPT_NO_TEXT=true             # batch FALLBACK only: rescue textless posters when a
#                                     # movie has ZERO titled survivors (never alongside them)
# OCR_RESIDUAL_SIGNIFICANT_AREA_FRACTION=0.005  # a confident residual box covering >= this
#                                     # fraction of the image is significant even when the
#                                     # recognizer garbled its text ("70MM" -> "mm")
# OCR_RESIDUAL_SIGNIFICANT_WIDTH_FRACTION=0.40  # ... or wider than this fraction of the image
# OCR_CONFIDENCE_THRESHOLD=0.75
# OCR_STRIP_CONFIDENCE_THRESHOLD=0.65
# OCR_BOTTOM_CONFIDENCE_THRESHOLD=0.50
# FACE_CONFIDENCE_THRESHOLD=0.5
# FACE_NMS_THRESHOLD=0.4

# --- Feedback loop (design 09) ---
# FEEDBACK_LABELS_PATH=marquee/experiments/feedback/labels.jsonl
# NEGATIVE_DATA_DIR=marquee/experiments/negative_data
# TRAINING_DATA_DIR=marquee/experiments/training_data
# FEEDBACK_GATE_ALERT_THRESHOLD=5
# FEEDBACK_NEGATIVES_FROM_OVERRIDES=false
# FEEDBACK_DEPLOY_DEFAULT=true
# HEAD_MIN_LABELS=150
# HEAD_MIN_MOVIES=5
# HEAD_AUTO_RETRAIN=true

# --- Additional pipeline knobs ---
# PERSON_CONFIDENCE_THRESHOLD=0.40
# CALIBRATION_ENABLED=true
# CALIBRATION_BANDWIDTH_SCALE=1.0
# CALIBRATION_MIN_SAMPLES=20
# ZEROSHOT_AXES_PATH=marquee/ml/zeroshot_axes.clip-vit-b-32.npz
# LEARNED_HEAD_PATH=marquee/ml/models/learned_head.clip-vit-b-32.npz
# DINO_MODEL_PATH=marquee/ml/models/dinov2-vits14.onnx
# PERSON_MODEL_PATH=marquee/ml/models/yolo11n.onnx

# --- Normalization ranges ---
# NORM_KNN_MIN=0.4
# NORM_KNN_MAX=0.9
# NORM_AESTHETIC_MAX=10.0
# NORM_TITLE_COLORFULNESS_MAX=60.0
# NORM_TITLE_COLORFULNESS_NEUTRAL=0.5
# NORM_RESOLUTION_MAX_MP=6.0
# NORM_SHARPNESS_MAX=2000.0
# NORM_OFFICIAL_MIN=0.60
# NORM_OFFICIAL_MAX=0.95

# --- Quality & provenance ---
# QUALITY_BLOCKINESS_SAT=6.0
# QUALITY_NOISE_SAT=12.0
# PROV_PRIOR_MEAN=6.5
# PROV_CONFIDENCE=25
# RESIDUAL_COUNT_SAT=5
# RESIDUAL_WEIGHT_COUNT=0.5
# RESIDUAL_WEIGHT_AREA=0.5

# --- Gate rescue ---
# GATE_AESTHETIC_RESCUE_KNN=0.55
# GATE_MIN_AESTHETIC_RESCUED=2.0

# --- OCR fine-tuning ---
# OCR_ENHANCE_RETRY=true
# OCR_FUZZY_CUTOFF=0.60
# OCR_TITLE_PROXIMITY_PIXELS=30.0
# OCR_RESIDUAL_SIGNIFICANT_AREA_FRACTION=0.005
# OCR_RESIDUAL_SIGNIFICANT_WIDTH_FRACTION=0.40

# --- Typicality features (KDE calibration) ---
# TYPICALITY_FEATURES='["darkness","mean_saturation","hue_entropy","global_colorfulness","contrast_rms","negative_space_frac","edge_density","visual_entropy","symmetry","title_height_frac","title_y_center","title_centeredness","face_count","largest_face_frac","person_count","person_area_frac","axis_illustrated","axis_minimalist","axis_vintage","aesthetic"]'
