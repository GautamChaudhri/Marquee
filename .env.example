# Marquee — environment configuration
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# APP_NAME=Marquee
# PORT=3165
# DEBUG=false
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# TMDB (The Movie Database)
# Register at: https://www.themoviedb.org/settings/api
# ---------------------------------------------------------------------------
# TMDB_READ_ACCESS_TOKEN=your_bearer_token_here

# ---------------------------------------------------------------------------
# Fanart.tv
# Register at: https://fanart.tv/get-an-api-key/
# ---------------------------------------------------------------------------
# FANART_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# TheTVDB
# Register at: https://thetvdb.com/api-information
# ---------------------------------------------------------------------------
# TVDB_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# Radarr
# API key found at: Radarr → Settings → General → API Key
# ---------------------------------------------------------------------------
# RADARR_URL=http://localhost:7878
# RADARR_API_KEY=your_radarr_api_key

# ---------------------------------------------------------------------------
# Sonarr
# API key found at: Sonarr → Settings → General → API Key
# ---------------------------------------------------------------------------
# SONARR_URL=http://localhost:8989
# SONARR_API_KEY=your_sonarr_api_key
# SERIES_POSTER_FORMAT=show.jpg
# SEASON_POSTER_FORMAT=season{season:02d}.jpg

# ---------------------------------------------------------------------------
# Path Mapping (only needed if running on different machine than *arrs)
#
# Radarr and Sonarr may see different mount paths than Marquee.
# Configure each pair independently — leave unset if paths are the same.
#
# Examples:
#   Radarr sees /plunder/movies, Mac sees /Volumes/PLUNDER/Media/Movies:
#     RADARR_PATH_PREFIX=/plunder/movies
#     RADARR_MEDIA_PATH=/Volumes/PLUNDER/Media/Movies
#
#   Sonarr sees /plunder/tv, Mac sees /Volumes/PLUNDER/Media/TV:
#     SONARR_PATH_PREFIX=/plunder/tv
#     SONARR_MEDIA_PATH=/Volumes/PLUNDER/Media/TV
# ---------------------------------------------------------------------------
# RADARR_PATH_PREFIX=/plunder/movies
# RADARR_MEDIA_PATH=/Volumes/PLUNDER/Media/Movies
# SONARR_PATH_PREFIX=/plunder/tv
# SONARR_MEDIA_PATH=/Volumes/PLUNDER/Media/TV

# ---------------------------------------------------------------------------
# Media Roots (optional — auto-derived from RADARR_MEDIA_PATH + SONARR_MEDIA_PATH)
#
# Manually add extra allowed directories if needed. Radarr/Sonarr media
# paths are automatically included. Leave empty to auto-derive only.
# ---------------------------------------------------------------------------
# MEDIA_ROOTS='["/Volumes/PLUNDER/Media/Movies","/Volumes/PLUNDER/Media/TV"]'

# ---------------------------------------------------------------------------
# Sync intervals (minutes)
# ---------------------------------------------------------------------------
# SYNC_INTERVAL_MINUTES=15
# HEAL_INTERVAL_MINUTES=30

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_URL=sqlite+aiosqlite:///./data/marquee.db

# ---------------------------------------------------------------------------
# Revised Poster Pipeline
# All values below are environment-overridable.
# ---------------------------------------------------------------------------
# AI_MODEL=clip-vit-b-32              # or clip-vit-b-32-int8 (CPU-only hosts; rebuild profile)
# EXECUTION_PROVIDER=auto             # auto | cuda | openvino | openvino-cpu | coreml | cpu
# CLIP_BATCH_SIZE=0                   # 0 = auto by hardware tier (GPU 32, CPU 8)
# K_NEIGHBORS=10
# KNN_WEIGHTING=softmax               # softmax = nearest exemplars dominate; mean = plain average
# KNN_SOFTMAX_TEMP=0.1                # smaller = sharper multimodal clusters
# TASTE_NEG_WEIGHT=1.0                # junk-lookalike penalty (needs negative exemplars)
# PREFERRED_LANG=en
#
# --- Extended features (design/07) ---
# DINO_ENABLED=auto                   # auto = on for GPU tiers, off on CPU; on/off force
# EXTRA_QUALITY_ENABLED=true          # rec-5 flag: artifact metrics + person detector
# CALIBRATION_ENABLED=true            # exemplar-calibrated typicality (rec 2)
# CALIBRATION_BANDWIDTH_SCALE=1.0     # >1 = wider/more forgiving taste bands
# SCORER=auto                         # auto | weighted | learned (Phase-1 head)
# WEIGHT_DINO_KNN=0.10
# WEIGHT_TASTE_TYPICALITY=0.10
# WEIGHT_QUALITY_ARTIFACTS=0.03
#
# CLIP_MODEL_PATH=marquee/ml/models/clip-vit-b-32.onnx     # follows AI_MODEL by default
# AESTHETIC_MODEL_PATH=marquee/ml/models/sa_0_4_vit_b_32_linear.pth
# FACE_MODEL_PATH=marquee/ml/models/scrfd_500m_bnkps.onnx
# TASTE_PROFILE_PATH=marquee/ml/taste_profile.clip-vit-b-32.npz  # follows AI_MODEL by default
# EMBEDDING_CACHE_DIR=data/cache/embeddings
#
# WEIGHT_KNN_SIM=0.30
# WEIGHT_AESTHETIC=0.20
# WEIGHT_TITLE_COLORFULNESS=0.15
# WEIGHT_FACE_AREA=0.15
# WEIGHT_TEXT_RESIDUAL=0.10
# WEIGHT_PROVENANCE=0.07
# WEIGHT_SHARPNESS=0.03
# WEIGHT_RESOLUTION=0.0
# WEIGHT_LANG_MATCH=0.0
#
# GATE_MIN_WIDTH=500
# GATE_MIN_AESTHETIC=4.5
# GATE_MIN_KNN_SIM=0.45
# GATE_FAN_JUNK_ENABLED=false
# GATE_FAN_JUNK_MAX_AESTHETIC=5.0
# GATE_FAN_JUNK_MAX_PROVENANCE=0.55
# GATE_FAN_JUNK_MAX_RESOLUTION_MP=1.0
#
# PROV_PRIOR_MEAN=6.5
# PROV_CONFIDENCE=25
# RESIDUAL_COUNT_SAT=5
# RESIDUAL_WEIGHT_COUNT=0.5
# RESIDUAL_WEIGHT_AREA=0.5
#
# DEDUP_PHASH_THRESHOLD=6
# DEDUP_MIN_POSTER_WIDTH=500
# OCR_WORKERS=0                       # 0 = auto-size from CPU/GPU profile
# OCR_DETAIL_PASSES=true              # false on weak CPUs (N150): ~60% faster OCR
# OCR_MAX_RESIDUAL_BOXES=0            # 0 = strict title-only text (project target);
#                                     # raise to 1-2 to tolerate taglines as rank penalty
# OCR_MAX_RESIDUAL_AREA_FRACTION=0.04 # secondary guard when boxes > 0
# OCR_CONFIDENCE_THRESHOLD=0.75
# OCR_STRIP_CONFIDENCE_THRESHOLD=0.65
# OCR_BOTTOM_CONFIDENCE_THRESHOLD=0.50
# FACE_CONFIDENCE_THRESHOLD=0.5
# FACE_NMS_THRESHOLD=0.4
