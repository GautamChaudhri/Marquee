# Marquee settings. Copy to .env and fill in real values; .env is never committed.
# Both settings classes (marquee.config.Settings and PipelineSettings) read this file, and
# Docker Compose reads it too: for the values in compose.yaml, and as the settings of the
# application containers.

# --- Docker Compose --------------------------------------------------------
# Which services `docker compose up -d` starts. Unset, only the database starts (development:
# the app runs on the host). On a machine that runs Marquee with Docker, set it to app: the
# database, the migration, the API, the worker, and the web app.
#COMPOSE_PROFILES=app
# The host folder the containers keep all of Marquee's data in (models, taste profile, runs,
# backups), mounted at /data in each. The containers run as user 1000, which must own it.
# Relative paths resolve against this folder. Back this folder up.
MARQUEE_DATA_HOST_PATH=./data
# The web app's address as your browser types it, scheme and port included. Required for the
# stack: without it the web app refuses to start, because every form post would be refused.
MARQUEE_WEB_ORIGIN=http://localhost:3000
# The host port the web app is published on, and the host address it listens on (0.0.0.0:
# every address, so other machines on the LAN can reach it; 127.0.0.1: this machine only).
# The web app is the only service published; the API is reached through it.
MARQUEE_WEB_PORT=3000
MARQUEE_WEB_BIND=0.0.0.0
# Behind a reverse proxy that serves HTTPS (see the README, "Serving Marquee over HTTPS"):
# the request header the proxy puts the visitor's address in, and, for x-forwarded-for, how
# many trusted proxies stand in front of Marquee. Leave both empty without a proxy. With a
# header set, reach Marquee only through the proxy (MARQUEE_WEB_BIND=127.0.0.1 when the proxy
# is on this machine): a request without that header is refused at sign-in.
MARQUEE_WEB_ADDRESS_HEADER=
MARQUEE_WEB_XFF_DEPTH=

# --- Application -----------------------------------------------------------
# Environment name, shown in logs and by `marquee doctor`. The Compose stack sets
# production for its containers: the API serves no interactive documentation, and the
# doctor fails where development only warns (no GPU, a mount a service needs). Each
# container is also told its role (MARQUEE_ROLE: api or worker), so the doctor checks what
# that service needs.
MARQUEE_ENVIRONMENT=development
# all (one machine runs everything), api, or worker; the stack sets it per container.
#MARQUEE_ROLE=all
# Extra diagnostics (for example the full OCR trace kept on each candidate).
DEBUG=false
# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Runtime data directory (models, caches, runs, backups). Relative paths resolve against the
# repo root. Inside the containers it is always /data (MARQUEE_DATA_HOST_PATH above).
DATA_DIR=data

# --- Database (also read by compose.yaml) ----------------------------------
# Host a process on the host connects to; Compose publishes Postgres on loopback only.
# Inside the stack the containers reach it as db:5432 whatever this says.
POSTGRES_HOST=127.0.0.1
# Host port Postgres is published on.
POSTGRES_PORT=5432
# Database role.
POSTGRES_USER=marquee
# Database password. Generate a long random value.
POSTGRES_PASSWORD=change-me
# Database name.
POSTGRES_DB=marquee

# --- Media library ---------------------------------------------------------
# Movie library roots, comma-separated absolute paths.
MOVIE_ROOTS=/path/to/media/movies
# The movie library's path on the Docker host. Compose mounts it at /media/movies in the
# application containers and sets MOVIE_ROOTS to that inside them: read-write in the worker,
# which writes posters (always backing up the one it replaces), read-only everywhere else.
# User 1000 must be able to write in its movie folders.
MOVIE_LIBRARY_HOST_PATH=/path/to/media/movies
# The folders in MOVIE_ROOTS as Radarr sees them, comma-separated, in the same order (for
# example Radarr's /data/movies for the MOVIE_ROOTS entry /path/to/media/movies). Leave it
# empty when Radarr sees the library at the same paths as Marquee. The database stores
# Radarr's paths; this pairing turns them into local ones, on the host and in a container.
RADARR_MOVIE_ROOTS=

# --- Integrations ----------------------------------------------------------
# TMDB API read access token (v4 bearer token).
TMDB_READ_ACCESS_TOKEN=
# Radarr base URL, for example http://radarr.example.lan:7878
RADARR_URL=
# Radarr API key.
RADARR_API_KEY=

# --- API -------------------------------------------------------------------
# The key every /api request must carry, as "Authorization: Bearer <key>" or "X-Api-Key: <key>".
# Unset, the API answers 503. You also sign in to the web app with it. In the Compose stack
# the web container gets it as MARQUEE_API_KEY and nothing else from this file. Generate one
# with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Address and port `marquee api` listens on, when it runs on the host. In the stack it
# listens on 0.0.0.0:8000 inside the stack's network and is not published.
API_HOST=127.0.0.1
API_PORT=8000

# --- Jobs ------------------------------------------------------------------
# How often `marquee worker` queues a library sync by itself, in minutes; 0 turns it off.
SYNC_INTERVAL_MINUTES=360
# Seconds without a GPU job after which the worker stops its GPU process, freeing the
# memory the models hold on the GPU.
GPU_IDLE_SECONDS=300
# How often the worker dumps the database by itself, in hours, into the data folder's
# backups/db/; 0 turns it off. After each scheduled dump the newest DB_BACKUP_KEEP of them are
# kept. `marquee db backup` makes one now (never deleted by Marquee).
DB_BACKUP_INTERVAL_HOURS=24
DB_BACKUP_KEEP=14
# How often the worker deletes what has gone stale (finished jobs, old runs nothing names,
# stale cache files, leftovers; see the README's "What Marquee deletes by itself"), in hours;
# 0 turns it off. The first pass is one interval after the worker first runs with it.
# `marquee retention --dry-run` lists what would go.
RETENTION_INTERVAL_HOURS=24
# Finished jobs, and runs nothing needs, older than this many days are deleted.
RETENTION_DAYS=90
# The GPU process's memory grows with every run. When a GPU job ends and that process holds
# more than this many MiB of memory, the worker replaces it before the next GPU job. 0 turns
# the check off.
GPU_CHILD_MAX_RSS_MB=4096

# --- Runs and deploys ------------------------------------------------------
# true: a library sync that succeeds queues a run of every movie that has never been run.
RUN_NEW_MOVIES=false
# What a finished run writes into the movie folder by itself:
#   off      nothing; every deploy is one you ask for (marquee deploy, or the API)
#   missing  only where the folder has no poster.jpg, or over the poster this policy itself
#            deployed last; never over one you chose (your own file, a poster you picked in
#            a review, one you put back, or one you replaced by hand)
#   all      also replaces posters you put there yourself
# Every write backs up the poster it replaces, and `marquee restore` undoes it.
DEPLOY_POLICY=off

# --- Blind evaluation --------------------------------------------------------
# A blind evaluation runs each movie without its own exemplars and looks for your poster among
# the candidates: by TMDB file name when it has one, otherwise the candidate whose CLIP
# embedding is closest, if its cosine is at least this.
EVAL_MATCH_MIN_COSINE=0.95

# --- Engine ----------------------------------------------------------------
# Where the CUDA driver keeps the GPU kernels it compiles for your card, and that cache's size
# limit in bytes. The driver reads both; unset, they are ~/.nv/ComputeCache and 1 GiB. The
# container image keeps the cache in the data folder (/data/cache/cuda-jit), so a new
# container does not compile them again. `marquee doctor` reports its size against the limit.
#CUDA_CACHE_PATH=
#CUDA_CACHE_MAXSIZE=
# ONNX Runtime provider: auto, cuda, cpu (aliases listed in marquee/ml/hardware.py).
EXECUTION_PROVIDER=auto
# Every other PipelineSettings field in marquee/config/pipeline.py can be set here by name
# (for example OCR_DEVICE=cpu). Leave them out to keep the defaults.
