# Marquee bootstrap and deployment settings
#
# Application, integration, media, poster, pipeline, taste, system, and access
# policy settings are managed from /settings. This file contains only values
# required before PostgreSQL and the Settings service can start.

MARQUEE_ENVIRONMENT=production
MARQUEE_HW=cpu

# Compose materializes these as service-scoped files under /run/secrets. They
# are not injected into container environments.
POSTGRES_PASSWORD=replace-with-a-long-random-password
API_KEY=replace-with-a-long-random-api-key

# Published origin. `:80` is fine for a trusted internal HTTP network. Set a
# real DNS name to let Caddy provision HTTPS before exposing Marquee publicly.
MARQUEE_SITE_ADDRESS=:80
MARQUEE_BIND_ADDRESS=127.0.0.1
MARQUEE_HTTP_PORT=8080
MARQUEE_HTTPS_PORT=8443

# Immutable container-side path authority. Values use JSON list syntax because
# pydantic-settings parses collection environment variables as JSON. Add only
# paths that are actually mounted into the API/worker containers.
MEDIA_PATH_CEILINGS=[]
# DATA_PATH_CEILING defaults to /app/data in Compose.

# Contained compute runs as this unprivileged identity; the worker remains root
# only long enough to read mode-0400 bootstrap secrets and transfer its workspace.
JOB_RUNNER_UID=65532
JOB_RUNNER_GID=65532

# Optional encrypted integration credential store. Generate a 32-byte key and
# place a 0600 JSON keyring outside this repository, then start Compose with:
#   -f docker/docker-compose.yml -f docker/compose.managed-secrets.yml
# Keyring shape:
# {"active_key_id":"v1","keys":{"v1":"<base64-encoded 32-byte key>"}}
# MARQUEE_SETTINGS_KEYRING_PATH=/absolute/path/to/marquee-settings-keyring.json

# Bare-host development may temporarily retain DB_URL and legacy integration
# credentials. On first managed-secret startup, TMDB/Radarr/Sonarr credentials
# are imported once; the UI reports their active source throughout the cutover.
