  "redaction": {
    "marker": "[REDACTED]",
    "configured_secrets": [
      "callback-secret",
      "db-pass",
      "hunter2",
      "s3cr3t-token"
    ],
    "text_cases": [
      {
        "name": "exact_configured_value",
        "chunks": [
          "prefix s3cr3t-token suffix"
        ],
        "expected": "prefix [REDACTED] suffix"
      },
      {
        "name": "authorization_bearer",
        "chunks": [
          "Authorization: Bearer s3cr3t-token"
        ],
        "expected": "Authorization: Bearer [REDACTED]"
      },
      {
        "name": "api_key_header",
        "chunks": [
          "X-Api-Key: s3cr3t-token"
        ],
        "expected": "X-Api-Key: [REDACTED]"
      },
      {
        "name": "url_userinfo_and_query",
        "chunks": [
          "https://dbuser:db-pass@example.test/path?api_key=s3cr3t-token&safe=ok"
        ],
        "expected": "https://[REDACTED]@example.test/path?api_key=[REDACTED]&safe=ok"
      },
      {
        "name": "cross_chunk_secret",
        "chunks": [
          "callback_token=callback-",
          "secret done"
        ],
        "expected": "callback_token=[REDACTED] done"
      },
      {
        "name": "safe_text",
        "chunks": [
          "encoding frame 42 at 24 fps"
        ],
        "expected": "encoding frame 42 at 24 fps"
      }
    ],
    "argument_cases": [
      {
        "name": "split_password_argument",
        "arguments": [
          "tool",
          "--password",
          "hunter2",
          "input.mkv"
        ],
        "expected": [
          "tool",
          "--password",
          "[REDACTED]",
          "input.mkv"
        ]
      },
      {
        "name": "joined_token_argument",
        "arguments": [
          "tool",
          "--token=s3cr3t-token",
          "input.mkv"
        ],
        "expected": [
          "tool",
          "--token=[REDACTED]",
          "input.mkv"
        ]
      },
      {
        "name": "database_url_argument",
        "arguments": [
          "tool",
          "--database-url",
          "postgresql://dbuser:db-pass@db/marquee"
        ],
        "expected": [
          "tool",
          "--database-url",
          "[REDACTED]"
        ]
      }
    ]
  }
