# Native macOS / Linux development. Copy to .env only for a new checkout;
# preserve an existing .env when switching machines or updating dependencies.
MARQUEE_ENVIRONMENT=development
DB_URL=postgresql+asyncpg://marquee:your-password@127.0.0.1:5432/marquee
DATA_DIR=./data
JOB_EMBEDDED_WORKERS=true
EXECUTION_PROVIDER=auto

# Generate a key with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Copy the same key into frontend/.env as MARQUEE_API_KEY.
API_KEY=replace-with-a-long-random-api-key
DEBUG=truee

# Native workers run under your login identity. Leave JOB_RUNNER_UID/GID unset;
# the numeric identities in .env.example belong to the container deployment.
# Configure integrations and media path mappings in Settings after startup.
# macOS media shares must be mounted under their actual /Volumes/... paths.
