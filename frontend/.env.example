# The SvelteKit server forwards /api/* to the backend with this key attached. Server-only:
# never exposed to the browser. Copy to `.env` (gitignored) and fill both in.
MARQUEE_API_URL=http://127.0.0.1:8000
MARQUEE_API_KEY=change-me

# Only for the built server (`node build`): the address the browser uses, so the
# same-origin check and the cookie's Secure flag see the right protocol.
# ORIGIN=http://localhost:3000
