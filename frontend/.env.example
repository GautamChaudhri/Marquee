# Backend (FastAPI) the SvelteKit server proxies to. Server-only — never exposed
# to the browser. Copy to `.env` and fill MARQUEE_API_KEY for non-DEBUG backends.
MARQUEE_API_URL=http://localhost:3165
# If backend is bound to a LAN IP (e.g. uvicorn --host 192.168.4.199), set this:
# MARQUEE_API_URL=http://192.168.4.199:3165
MARQUEE_API_KEY=

# Set to "true" to serve built-in fixtures instead of the real backend.
PUBLIC_USE_MOCKS=false
