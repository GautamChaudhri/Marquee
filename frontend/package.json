{
	"name": "frontend",
	"private": true,
	"version": "0.1.0",
	"license": "GPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "npm run api:types",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "npm run api:types && svelte-kit sync",
		"api:types": "openapi-typescript openapi.json --output src/lib/api/generated/schema.d.ts",
		"precheck": "npm run api:types",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"test": "npm run test:unit && npm run test:e2e"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.12.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-node": "^6.0.6",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.1",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "29.1.1",
		"openapi-typescript": "7.13.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "4.1.12"
	},
	"dependencies": {
		"openapi-fetch": "0.17.0",
		"svelte-dnd-action": "0.9.80"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
